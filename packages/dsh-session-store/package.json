{
  "name": "@codex-to-dsh/dsh-session-store",
  "version": "0.1.0",
  "description": "Discover, list, search, trash, and transfer DSH sessions without booting the harness",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunkaiWang-TheoPhy/codex-to-dsh-exporter.git",
    "directory": "packages/dsh-session-store"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
